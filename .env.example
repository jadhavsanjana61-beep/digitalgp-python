# Copy this file to .env and fill in real values. .env itself is gitignored
# (never commit real secrets) -- see README.md "नवीन laptop वर सेटअप".

DEBUG=True
SECRET_KEY=change-this-to-any-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
BASE_DOMAIN=localhost

# Local Postgres (see README.md for how these were installed/created).
# On Render, DATABASE_URL is provided automatically instead -- these are ignored there.
DB_NAME=digitalgp_db
DB_USER=postgres
DB_PASSWORD=digitalgp123
DB_HOST=localhost
DB_PORT=5432

# Only needed if ffmpeg isn't at the default D:\DevTools\ffmpeg\bin\ffmpeg.exe
# FFMPEG_PATH=D:\DevTools\ffmpeg\bin\ffmpeg.exe
